<?xml version="1.0" encoding="UTF-8"?>
<!--使用的是 XML 1.0 版本的语法规范 ||  UTF8编码方式-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程。好处：以后引官方依赖不用写版本号，它自动帮你管理版本（防止版本冲突）。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- 为空代表去远程仓库找，不在本地找 -->
    </parent>


    <!-- 你的项目坐标 -->
    <groupId>com.market</groupId>
    <artifactId>market-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging> <!-- 打包成 jar 包，最终用 java -jar 运行 -->

    <!-- 集中管理版本号。下面依赖里用 ${xxx} 就能引用了 -->
    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <dependencies>
        <!-- ================== Web 核心 ================== -->
        <!-- Web 启动器：内置 Tomcat 服务器、Spring MVC，让我们能写 @RestController 接收 HTTP 请求 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：提供 @Valid、@NotBlank、@Email 等注解，防止前端传脏数据 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：统一记录管理员写操作，避免每个 Controller 重复编写日志代码。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- WebSocket：提供长连接服务，用于后端主动给前端推消息 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>


        <!-- ================== 数据库相关 ================== -->
        <!-- MyBatis-Plus 启动器：你学过的 MyBatis 的增强版，单表增删改查不用写 SQL 了 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动：Java 连 MySQL 的底层通讯包（scope=runtime 表示写代码时用不到，运行时才需要它） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis 缓存：用来存 Token、验证码、热点数据等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>


        <!-- ================== 安全与认证 ================== -->
        <!-- Spring Security：安全框架，负责拦截所有请求，做登录认证和权限校验（配合 JWT 使用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT 三剑客：用来生成和解析 Token 字符串 -->
        <!-- api：写代码时用的接口 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- impl：底层的具体实现（运行时才需要） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- jackson：帮我们把 JWT 里的 JSON 数据转成 Java 对象 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>


        <!-- ================== 工具与第三方服务 ================== -->
        <!-- Lombok：必用神器。加上 @Data 注解，自动生成 getter/setter，让你少写几百行废代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 阿里云核心 SDK：一般用来发短信验证码 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-core</artifactId>
            <version>4.6.3</version>
            <exclusions>
                <!-- Spring Boot 已通过 spring-jcl 提供 Commons Logging 兼容层，避免重复实现冲突。 -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 阿里云号码认证：本系统用来做手机号一键登录或验证码校验 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-dypnsapi</artifactId>
            <version>1.2.10</version>
        </dependency>


        <!-- ================== 测试 ================== -->
        <!-- 包含 JUnit、Mockito 等测试工具（scope=test 表示只在写测试用例时能用，不会打包进最终代码） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 官方打包插件：负责把项目打成一个能直接运行的胖 JAR 包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- 重点：打包时排除 Lombok。因为 Lombok 的作用只是编译期生成代码，打包后就不需要它了，排除能减小 JAR 体积 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
